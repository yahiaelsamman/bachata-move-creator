{
  "name": "Bachata Move Creator",
  "short_name": "Bachata Moves",
  "description": "Link social dance moves like dominoes and build new combinations.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#acc13f",
